{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:wind_rising_emitter",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/gust"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "Math.random(0, 1) > 0.2 ? 0 : 1"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": ["Math.random(-variable.radius/2, variable.radius/2)", "Math.random(-variable.radius/2, variable.radius/2)", "Math.random(-variable.radius/2, variable.radius/2)"],
				"direction": ["v.facing_dir.x", "v.facing_dir.y", "v.facing_dir.x"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random( 0.6, 0.8 )"
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["v.facing_dir.x*5", "v.facing_dir.y*5", "v.facing_dir.x*5"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [1, 1],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 384,
					"texture_height": 32,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [32, 32],
						"step_UV": [32, 0],
						"frames_per_second": 12,
						"max_frame": 12,
						"stretch_to_lifetime": true
					}
				}
			}
		}
	}
}