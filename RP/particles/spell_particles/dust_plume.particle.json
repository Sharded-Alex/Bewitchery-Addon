						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": ["0.73 - variable.particle_random_1 * 0.2", "0.69 - variable.particle_random_1 * 0.2", "0.76 - variable.particle_random_1 * 0.2", 1]
