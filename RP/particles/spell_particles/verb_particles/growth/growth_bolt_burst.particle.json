{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:growth_bolt_burst",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/pale_oak_leaves_atlas"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "Math.random(15, 19)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.05,
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.45 + Math.random(0.0, 0.45)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)",
				"rotation_rate": "math.random(-30, 30)"
			},
			"minecraft:particle_initial_speed": 9.8,
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 6.7,
				"rotation_acceleration": "v.particle_random_4 > 0.5 ? -5 : 5"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.particle_random_1 > 0.5 ? 0.1 : 0.15 * ((v.particle_lifetime - v.particle_age)/v.particle_lifetime)", "v.particle_random_1 > 0.5 ? 0.1 : 0.15 * ((v.particle_lifetime - v.particle_age)/v.particle_lifetime)"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 28,
					"texture_height": 21,
					"uv": ["math.floor(v.particle_random_1 * 4) * 7", "math.floor(v.particle_random_2 * 3) * 7"],
					"uv_size": [7, 7]
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": ["variable.color.r", "variable.color.g", "variable.color.b", 1]
			}
		}
	}
}