{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:growth_cube_particle",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/pale_oak_leaves_atlas"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "Math.random(5, 9)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"offset": ["v.offset.x", "v.offset.y", "v.offset.z"],
				"half_dimensions": ["v.dimensions.x", "v.dimensions.y", "v.dimensions.z"],
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 6
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)",
				"rotation_rate": "math.random(-30, 30)"
			},
			"minecraft:particle_initial_speed": 0.01,
			"minecraft:particle_motion_dynamic": {
				"rotation_acceleration": "v.particle_random_4 > 0.5 ? -5 : 5"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.particle_random_1 > 0.5 ? 0.1 : 0.15", "v.particle_random_1 > 0.5 ? 0.1 : 0.15"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 28,
					"texture_height": 21,
					"uv": ["math.floor(v.particle_random_1 * 4) * 7", "math.floor(v.particle_random_2 * 3) * 7"],
					"uv_size": [7, 7]
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": ["variable.color.r", "variable.color.g", "variable.color.b", 1]
			}
		}
	}
}