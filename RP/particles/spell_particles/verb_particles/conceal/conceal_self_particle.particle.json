{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:conceal_self_particle",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = Math.random(0.08, 0.14);"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "Math.random(9, 15)",
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 2
			},
			"minecraft:emitter_shape_point": {
				"offset": ["Math.random(-0.65, 0.65)", "Math.random(1, 1.8)", "Math.random(-0.65, 0.65)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "1.5 + (Math.random(0.0, 1.0))"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -0.4, 0]
			},
			"minecraft:particle_motion_collision": {
				"enabled": "v.particle_age > 0.45",
				"collision_drag": 1,
				"coefficient_of_restitution": 1,
				"collision_radius": 0.01,
				"expire_on_contact": false
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.05, 0.05],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": ["variable.particle_random_3 < 0.5 ? Math.round(variable.particle_random_2 * 14) * 8 + 8 : Math.round(variable.particle_random_2 * 10) * 8", "variable.particle_random_3 < 0.5 ? 112 : 120"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.color.r", "v.color.g", "v.color.b", "v.particle_lifetime - v.particle_age"]
			}
		}
	}
}