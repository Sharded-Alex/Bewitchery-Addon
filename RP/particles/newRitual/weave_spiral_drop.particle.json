{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:weave_spiral_drop",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.radius;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true,
				"velocity": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 8,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": "v.radius"
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, "v.radius-v.emitter_age", 0],
				"direction": ["Math.random(-0.25, 0.25)", 0.5, "Math.random(-0.25, 0.25)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 9
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 0.2
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.05 + variable.particle_random_1*0.05", "0.05 + variable.particle_random_1*0.05"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": ["variable.particle_random_3 < 0.5 ? Math.round(variable.particle_random_2 * 14) * 8 + 8 : Math.round(variable.particle_random_2 * 10) * 8", "variable.particle_random_3 < 0.5 ? 112 : 120"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.1,
				"enabled": "variable.particle_age > 1"
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.particle_random_1 + 0.25", "v.particle_random_2 + 0.25", "v.particle_random_3 + 0.25", 1]
			}
		}
	}
}