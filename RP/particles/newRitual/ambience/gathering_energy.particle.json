{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw_ritual:gathering_energy",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.radius = 0.5;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true,
				"velocity": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.particle_amt"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "v.ball_size",
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2.7
			},
			"minecraft:particle_initial_speed": 0.1,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.13, 0],
				"linear_drag_coefficient": 0.2
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(v.particle_lifetime - v.particle_age)*0.05", "(v.particle_lifetime - v.particle_age)*0.05"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": ["variable.particle_random_3 < 0.5 ? Math.round(variable.particle_random_2 * 14) * 8 + 8 : Math.round(variable.particle_random_2 * 10) * 8", "variable.particle_random_3 < 0.5 ? 112 : 120"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.particle_random_1", "v.particle_random_2", "v.particle_random_3", "v.particle_age/v.particle_lifetime +0.2"]
			}
		}
	}
}