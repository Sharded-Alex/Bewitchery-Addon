{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw_ritual:dispersing_energy",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.random(20, 30)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 2
			},
			"minecraft:emitter_shape_disc": {
				"radius": 0.15,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2.7
			},
			"minecraft:particle_initial_speed": 5,
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 3.4
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(v.particle_lifetime - v.particle_age)*0.05", "(v.particle_lifetime - v.particle_age)*0.05"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": ["variable.particle_random_3 < 0.5 ? Math.round(variable.particle_random_2 * 14) * 8 + 8 : Math.round(variable.particle_random_2 * 10) * 8", "variable.particle_random_3 < 0.5 ? 112 : 120"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.particle_random_1", "v.particle_random_2", "v.particle_random_3", "v.particle_age/v.particle_lifetime +0.2"]
			}
		}
	}
}