{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:malice_rite_stage_one",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/gust"
			}
		},
		"curves": {
			"variable.size": {
				"type": "bezier",
				"input": "v.particle_age + 0.5",
				"horizontal_range": "v.particle_lifetime + 0.5",
				"nodes": [0, 0.76, -0.82, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 15,
				"max_particles": 200
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 5
			},
			"minecraft:emitter_shape_disc": {
				"radius": "variable.emitter_age - variable.emitter_lifetime",
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random( 1.4, 1.8 )"
			},
			"minecraft:particle_initial_speed": 0.2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "Math.random(0.12, 1.36)", 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size", "v.size"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 384,
					"texture_height": 32,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [32, 32],
						"step_UV": [32, 0],
						"frames_per_second": 12,
						"max_frame": 12,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.32": "#FF1E1919",
						"0.67": "#FF941A1A"
					}
				}
			}
		}
	}
}