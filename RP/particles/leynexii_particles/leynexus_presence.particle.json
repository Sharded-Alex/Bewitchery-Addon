{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:leynexus_presence",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"curves": {
			"variable.size": {
				"type": "bezier_chain",
				"input": "v.particle_age / v.particle_lifetime",
				"nodes": {
					"0.0": {
						"value": 1,
						"slope": 0
					},
					"1.0": {
						"value": 0,
						"slope": -2.75
					},
					"0.8": {
						"value": 1,
						"slope": 0
					}
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "Math.random_integer(6, 12)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_disc": {
				"radius": 6,
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.particle_random_3 * 2 + 3"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "variable.particle_random_3 * 10 * (1 - variable.particle_age / variable.particle_lifetime)", 0],
				"linear_drag_coefficient": 3
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.2 * variable.size", "0.2 * variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [0, 11],
						"size_UV": [1, 1],
						"step_UV": [1, 0],
						"max_frame": 7,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [0.45, "0.45 + variable.particle_random_1 * 0.4", "0.6 + variable.particle_random_1 * 0.4", 1]
			}
		}
	}
}