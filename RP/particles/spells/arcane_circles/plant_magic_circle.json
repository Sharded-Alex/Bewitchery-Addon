{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:plant_magic_circle",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/form_images/summon_symbol"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
			  "direction": ["variable.facing.x", "variable.facing.y", "variable.facing.z"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.life_time"
			},
			"minecraft:particle_initial_spin": {
				"rotation_rate": -360
			},
			"minecraft:particle_motion_parametric": {
			  "rotation": "-variable.particle_age * 360"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.circle_size", "variable.circle_size"],
				"facing_camera_mode": "direction_z",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [0, 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["variable.color.r", "variable.color.g", "variable.color.b", "variable.life_time - 1 <= variable.particle_age ? variable.life_time - (variable.particle_age) : 1"]
			}
		}
	}
}