{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:splash_spell_emitter_dome",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"events": {
			"bw:effect_burst": {
			  "sequence": [
			    {
            "expression": "t.red_color = v.color.r;"
          },
			    {
            "expression": "t.blue_color = v.color.b;"
          },
			    {
            "expression": "t.green_color = v.color.g;"
          },
			    {
            "expression": "t.alpha_color = v.color.a;"
          },
          {
    				"particle_effect": {
    					"effect": "bw:potion_spell_fallen_burst",
    					"type": "emitter",
    					"pre_effect_expression": "v.color.r = t.red_color; v.color.g = t.green_color; v.color.b = t.blue_color; v.color.a = t.alpha_color;"
    				}
          }
			  ]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.radius;v.part_amount=28;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.part_amount*v.radius"
			},
			"minecraft:particle_lifetime_events": {
				"expiration_event": "bw:effect_burst"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "v.radius",
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 8
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["Math.random(-2, 2)", "Math.random(-1.5, -0.8)", "Math.random(-2, 2)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.125, 0.125],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [56, 64],
						"size_UV": [8, 8],
						"step_UV": [-8, 0],
						"frames_per_second": 10,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"collision_radius": 0.1,
				"expire_on_contact": true,
				"events": [
					{
						"event": "bw:effect_burst",
						"min_speed": 0
					}
				]
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.color.r", "v.color.g", "v.color.b", "v.color.a"]
			}
		}
	}
}