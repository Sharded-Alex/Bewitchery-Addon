{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ubd:lightning_line",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particles/white"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.direction;variable.length;variable.plane;variable.width;variable.alpha;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.08
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.3
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.length + 0.02", "(variable.width + math.random(-0.005,0.005))"],
				"facing_camera_mode": "lookat_direction",
				"direction": {
					"mode": "custom",
					"custom_direction": ["variable.direction.x", "variable.direction.y", "variable.direction.z"]
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["Math.min(1, variable.plane.x + Math.max(0, 0.3*(variable.particle_random_1 - 0.5)))", "Math.min(1, variable.plane.y + Math.max(0, 0.1*(variable.particle_random_1 - 0.5)))", "Math.min(1, variable.plane.z + Math.max(0, 0.3*(variable.particle_random_1 - 0.5)))", "variable.alpha - (variable.particle_age / variable.particle_lifetime)"]
			}
		}
	}
}