{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:breath_particle",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "variable.particlecount"
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 0.3
			},
			"minecraft:emitter_shape_point": {
				"direction": ["v.spray.x*8", "v.spray.y*8", "v.spray.z*8"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(1.3, 2.5)"
			},
			"minecraft:particle_initial_speed": "(Math.random(0, 1) + Math.random(0, 1) + 1) * 1.2",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["v.spray.x + Math.random(-3.5,3.5)", "v.spray.y + Math.random(-3.5,3.5)", "variable.spray.z + Math.random(-3.5,3.5)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.125, 0.125],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 64],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 10,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"enabled": 1,
				"collision_drag": 0.1,
				"coefficient_of_restitution": 0.2,
				"collision_radius": 0.05
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": ["variable.color.r", "variable.color.g", "variable.color.b", "variable.color.a"]
			}
		}
	}
}