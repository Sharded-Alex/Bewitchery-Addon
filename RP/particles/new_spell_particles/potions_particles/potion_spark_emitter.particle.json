{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:potion_spark_emitter",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 0.89, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.3
			},
			"minecraft:emitter_shape_point": {
				"offset": ["Math.random(-0.32,0.32)", "Math.random(-0.32,0.32)", "Math.random(-0.32,0.32)"],
				"direction": ["Math.random(-0.15, 0.15)", "Math.random(-0.15, 0.15)", "Math.random(-0.15, 0.15)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(0.3, 0.4)"
			},
			"minecraft:particle_initial_speed": "(Math.random(0, 1) + Math.random(0, 1) + 1) * 0.2",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(variable.particle_random_1 * 2 - 1) - (variable.particle_age * 0.4)", 0, "(variable.particle_random_2 * 2 - 1) - (variable.particle_age * 0.4)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.125 * v.size", "0.125 * v.size"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": ["64-8*6", "64-8*2"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["variable.spell_color.r", "variable.spell_color.g", "variable.spell_color.b", 1]
			}
		}
	}
}