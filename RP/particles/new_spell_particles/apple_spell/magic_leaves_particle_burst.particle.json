{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bw:magic_leaves_particle_burst",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/cherry_petal_atlas"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.wind_acc=Math.random(1,-1);v.curve_len=0.72;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.random(7, 14)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0, 0],
				"radius": 0.15,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 3.2
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,360)",
				"rotation_rate": "math.random(-30,30)"
			},
			"minecraft:particle_initial_speed": 3,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.cos(v.particle_random_3 * 60) * v.wind_acc * math.pow(math.min(v.curve_len, v.particle_age) / v.curve_len, 1.25)", -1.2, "math.sin(v.particle_random_3 * 60) * v.wind_acc * math.pow(math.min(v.curve_len, v.particle_age) / v.curve_len, 1.25)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.particle_random_1 > 0.5 ? 0.05 : 0.075", "v.particle_random_1 > 0.5 ? 0.05 : 0.075"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 12,
					"texture_height": 9,
					"uv": ["math.floor(v.particle_random_1 * 4) * 3", "math.floor(v.particle_random_2 * 3) * 3"],
					"uv_size": [3, 3]
				}
			},
			"minecraft:particle_motion_collision": {
			  "enabled": "v.particle_age > 0.6",
				"collision_drag": 10,
				"collision_radius": 0.075
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.color.r", "v.color.g", "v.color.b", 1]
			}
		}
	}
}