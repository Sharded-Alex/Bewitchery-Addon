{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "bw:oak_broom_item",
			"materials": {
				"default": "skeleton",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/entity/brooms/normal_broom",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.broom_player"
			},
			"animations": {
				"hold_first_person": "animation.broom_attc.first_person",
				"hold_third_person": "animation.broom_attc.third_person"
			},
			"scripts": {
				"animate": [
					{
						"hold_first_person": "context.is_first_person == 1.0"
					},
					{
						"hold_third_person": "context.is_first_person == 0.0"
					}
				]
			},
			"render_controllers": [
				"controller.render.default"
			]
		}
	}
}