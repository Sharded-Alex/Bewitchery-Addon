{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "bw:default_broom",
      "is_summonable": true,
      "is_spawnable": false,
      "properties": {
        "bw:red_color": {
          "type": "float",
          "range": [
            0.001,
            1.1
          ],
          "default": 0.001,
          "client_sync": true
        },
        "bw:green_color": {
          "type": "float",
          "range": [
            0.001,
            1.1
          ],
          "default": 0.001,
          "client_sync": true
        },
        "bw:blue_color": {
          "type": "float",
          "range": [
            0.001,
            1.1
          ],
          "default": 0.001,
          "client_sync": true
        },
        "bw:durability": {
          "type": "int",
          "range": [
            0,
            500
          ],
          "default": 0
        },
        "bw:dmg": {
          "type": "int",
          "range": [
            1,
            10
          ],
          "default": 1
        }
      }
    },
    "component_groups": {
      "bw:falling_broom": {
        "minecraft:buoyant": {
          "base_buoyancy": 1.0,
          "apply_gravity": true,
          "simulate_waves": true,
          "big_wave_probability": 0.03,
          "big_wave_speed": 10.0,
          "liquid_blocks": [
            "minecraft:water",
            "minecraft:flowing_water"
          ]
        }
      },
      "bw:fall_cooldown": {
        "minecraft:timer": {
          "looping": true,
          "time": 60.0,
          "time_down_event": {
            "filters": {
              "all_of": [
                {
                  "test": "on_ground",
                  "operator": "!=",
                  "value": true
                }
              ]
            },
            "event": "bw:broom_fall",
            "target": "self"
          }
        }
      },
      "bw:mobile_broom": {
        "minecraft:movement": {
          "value": 0.1
        },
        "minecraft:flying_speed": {
          "value": 0.1
        },
        "minecraft:knockback_resistance": {
          "value": 0.0
        },
        "minecraft:free_camera_controlled": {
          "strafe_speed_modifier": 1.0,
          "backwards_movement_modifier": 0.5
        },
        "minecraft:vertical_movement_action": {
          "vertical_velocity": 0.5
        },
        "minecraft:movement.hover": {},
        "minecraft:behavior.player_ride_tamed": {
          "priority": 1
        }
      },
      "bw:tamed": {
        "minecraft:is_tamed": {}
      },
      "bw:immobile_broom": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:flying_speed": {
          "value": 0.0
        },
        "minecraft:knockback_resistance": {
          "value": 1.0
        },
        "minecraft:pushable": {
          "is_pushable": false,
          "is_pushable_by_piston": true
        },
        "minecraft:movement.hover": {},
        "minecraft:body_rotation_blocked": {},
        "minecraft:rotation_axis_aligned": {},
        "minecraft:is_collidable": {},
        "minecraft:is_stackable": {}
      }
    },
    "components": {
      "minecraft:collision_box": {
        "height": 0.65,
        "width": 0.65
      },
      "minecraft:physics": {
        "has_gravity": false
      },
      "minecraft:can_fly": {},
      "minecraft:jump.static": {},
      "minecraft:rideable": {
        "seat_count": 2,
        "family_types": [
          "player"
        ],
        "dismount_mode": "on_top_center",
        "controlling_seat": 1,
        "on_rider_enter_event": "bw:begin_flight",
        "on_rider_exit_event": "bw:end_flight",
        "crouching_skip_interact": true,
        "interact_text": "action.interact.ride.horse",
        "seats": [
          {
            "position": [
              0.0,
              1.24,
              0.41
            ],
            "min_rider_count": 0,
            "max_rider_count": 1,
            "third_person_camera_radius": 8.0,
            "camera_relax_distance_smoothing": 6.0
          },
          {
            "position": [
              0.0,
              1.34,
              0.81
            ],
            "min_rider_count": 2,
            "max_rider_count": 2,
            "third_person_camera_radius": 8.0,
            "camera_relax_distance_smoothing": 6.0
          },
          {
            "position": [
              0.0,
              1.24,
              0.41
            ],
            "min_rider_count": 2,
            "max_rider_count": 2,
            "third_person_camera_radius": 8.0,
            "camera_relax_distance_smoothing": 6.0
          }
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_sneak_held",
                    "subject": "other",
                    "value": true
                  }
                ]
              },
              "target": "self",
              "event": "bw:become_broom"
            },
            "vibration": "entity_act",
            "interact_text": "Broomify"
          }
        ]
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:on_hurt": {
        "event": "bw:damage_broom"
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          },
          {
            "cause": "all",
            "deals_damage": true,
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_damage",
                    "value": "fatal"
                  }
                ]
              },
              "event": "bw:become_broom"
            }
          }
        ]
      },
      "minecraft:inside_block_notifier": {
        "block_list": [
          {
            "block": {
              "name": "minecraft:water"
            },
            "entered_block_event": {
              "event": "bw:broom_boatify",
              "target": "self"
            },
            "exited_block_event": {
              "event": "bw:broom_unboatify",
              "target": "self"
            }
          },
          {
            "block": {
              "name": "minecraft:flowing_water"
            },
            "entered_block_event": {
              "event": "bw:broom_boatify",
              "target": "self"
            },
            "exited_block_event": {
              "event": "bw:broom_unboatify",
              "target": "self"
            }
          }
        ]
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:body_rotation_always_follows_head": {}
    },
    "events": {
      "bw:broom_boatify": {
        "add": {
          "component_groups": [
            "bw:falling_broom"
          ]
        }
      },
      "bw:broom_unboatify": {
        "remove": {
          "component_groups": [
            "bw:falling_broom"
          ]
        }
      },
      "bw:broom_fall": {
        "remove": {
          "component_groups": [
            "bw:immobile_broom"
          ]
        },
        "add": {
          "component_groups": [
            "bw:falling_broom"
          ]
        }
      },
      "bw:begin_flight": {
        "remove": {
          "component_groups": [
            "bw:immobile_broom",
            "bw:fall_cooldown",
            "bw:falling_broom"
          ]
        },
        "add": {
          "component_groups": [
            "bw:mobile_broom"
          ]
        }
      },
      "bw:become_broom": {},
      "bw:damage_broom": {
        "sequence": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "random_chance",
                  "value": 20
                },
                {
                  "test": "int_property",
                  "domain": "bw:durability",
                  "operator": "==",
                  "value": 500
                }
              ]
            },
            "set_property": {
              "bw:durability": "q.property('bw:durability')"
            },
            "trigger": "bw:become_broom"
          }
        ]
      },
      "bw:end_flight": {
        "remove": {
          "component_groups": [
            "bw:mobile_broom"
          ]
        },
        "add": {
          "component_groups": [
            "bw:immobile_broom",
            "bw:fall_cooldown"
          ]
        }
      }
    }
  }
}